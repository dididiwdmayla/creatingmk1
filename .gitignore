# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# material bruto de skins (clones de referência, fora do app)
/skins-raw/

# capturas do laço de verificação visual (scripts/qa-visual.mjs) — evidência
# de sessão, se regenera rodando o script; nunca entra no histórico
/qa-shots/

# mídia efêmera do laço de captura (scripts/qa-titulo.mjs grava um webm aqui
# pra exercitar o vídeo-no-título; apagada no fim da rodada)
/public/qa-tmp/
