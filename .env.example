# Chave da Google Places API (New). NUNCA exposta ao cliente — usada só em
# route handlers server-side, sempre através do módulo de custos.
GOOGLE_PLACES_API_KEY=

# Credenciais do service account do Firebase (Firestore + Storage via admin).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Colar com \n literais (a Vercel armazena assim); admin.ts converte.
FIREBASE_PRIVATE_KEY=

# Bucket do Firebase Storage para as imagens de demo (ex.: <projeto>.appspot.com).
FIREBASE_STORAGE_BUCKET=

# Senha única do app. Sem ela, TUDO responde 503 (fail-closed).
APP_PASSWORD=
