# Chave da Google Places API (New). NUNCA exposta ao cliente — usada só em
# route handlers server-side, sempre através do módulo de custos.
GOOGLE_PLACES_API_KEY=

# Credenciais do service account do Firebase (Firestore + Storage via admin).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Colar com \n literais (a Vercel armazena assim); admin.ts converte.
FIREBASE_PRIVATE_KEY=

# Bucket do Firebase Storage para as imagens de demo (ex.: <projeto>.appspot.com).
FIREBASE_STORAGE_BUCKET=

# Chave do Google Gemini (sugestões de IA da Forja de Demos). OPCIONAL:
# sem ela as funcionalidades de IA ficam ocultas/desabilitadas com aviso —
# nada quebra. Usada só server-side, sempre através do módulo de custos
# (SKU aiGeneration, teto default 50/mês).
GEMINI_API_KEY=

# Segredo do app: assina os cookies de sessão (multiusuário) e é a senha
# INICIAL do admin (migrada para /usuarios no primeiro login). Sem ela,
# TUDO responde 503 (fail-closed). Trocá-la derruba todas as sessões.
APP_PASSWORD=

# Segredo do cron diário de buscas recorrentes (/api/cron). A Vercel envia
# "Authorization: Bearer ${CRON_SECRET}" nas chamadas agendadas (vercel.json);
# sem a variável, a rota responde 503 e nenhuma busca recorrente roda.
CRON_SECRET=

# Token do GitHub que dispara o workflow de capturas das demos
# (.github/workflows/capturas.yml, via repository_dispatch). Fine-grained
# com permissão de escrita em Contents do repositório, ou classic com
# `repo`. OPCIONAL: sem ele o botão "Gerar capturas" aparece desabilitado e
# a rota responde 503 explicando o que falta — nada mais quebra. Usado só
# server-side, nunca chega ao cliente.
GITHUB_CAPTURAS_TOKEN=

# Repositório "owner/repo" do workflow. Na Vercel é opcional: as variáveis
# VERCEL_GIT_REPO_OWNER/VERCEL_GIT_REPO_SLUG do deploy já respondem isso.
GITHUB_CAPTURAS_REPO=

# Endereço público do Radar (ex.: https://radar.exemplo.com), SEM barra no
# fim. Usada pelo motor de capturas: é o endereço que a moldura de
# navegador exibe na captura de desktop. Não dá pra deduzir — no runner o
# app roda em 127.0.0.1. OPCIONAL: sem ela a pastilha de endereço sai
# VAZIA, que é o certo — a moldura nunca inventa domínio.
APP_PUBLIC_URL=
